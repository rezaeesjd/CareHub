# -----------------------------------------------------------------------------
# Florence Care 24 — public build-time configuration
# Copy to `.env` for local development. Only PUBLIC_* values may appear here:
# they are baked into the static site and are visible to anyone.
#
# HOSTING / DEPLOYMENT CREDENTIALS DO NOT BELONG HERE.
# They live in GitHub Actions Secrets — see docs/DEPLOYMENT.md.
# -----------------------------------------------------------------------------

# Production domain (no trailing slash). REQUIRED before going live — used for
# canonical URLs, hreflang, sitemap, structured data and Open Graph.
PUBLIC_SITE_URL=https://florencecare24.com

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave blank to ship
# NO analytics and NO cookies (no cookie banner needed).
PUBLIC_GA_ID=

# Google Tag Manager container ID (e.g. GTM-XXXXXXX). Optional; leave blank to
# skip. If both GA and GTM are set, load GA through GTM to avoid double-counting.
PUBLIC_GTM_ID=

# Contact details are configured in src/config/site.ts (not here) so they are
# always available at build time. They currently are:
#   Phone / WhatsApp: +39 375 837 4492
#   Email:            florencecare24h@gmail.com
