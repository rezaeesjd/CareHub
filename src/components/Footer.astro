---
import {site} from '../config/site'; import {t,paths,type Lang} from '../i18n/content'; import {emailUrl,phoneUrl,whatsappUrl} from '../lib/links';
interface Props{lang:Lang} const {lang}=Astro.props,x=t[lang],p=paths[lang];
---
<footer><div class="shell footer-grid"><div><strong>Florence Care 24</strong><p>Healthcare Assistance & Coordination</p><p>{site.serviceArea}</p></div><div><strong>{x.contact}</strong><a href={phoneUrl()} data-channel="phone">{site.phoneDisplay}</a><a href={whatsappUrl(lang)} data-channel="whatsapp">WhatsApp</a><a href={emailUrl()} data-channel="email">{site.email}</a></div><div><strong>Explore</strong><a href={`${p.home}#services`}>{x.services}</a><a href={p.tourist}>{x.tourists}</a><a href={p.partners}>{x.partners}</a><a href={p.contact}>{x.contact}</a></div><div><strong>Legal</strong><a href={p.privacy}>{x.privacy}</a><a href={p.cookies}>{x.cookies}</a><a href={p.terms}>{x.terms}</a><a href={p.professional}>{x.professional}</a><a href={p.accessibility}>{x.accessibility}</a></div></div><div class="shell footer-bottom"><span>© {new Date().getFullYear()} Florence Care 24</span><span><a href="/en/">English</a> · <a href="/it/">Italiano</a></span></div></footer>
