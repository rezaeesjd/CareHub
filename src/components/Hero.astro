---
/**
 * Homepage hero. Mobile-first: on a 390px screen the visitor sees headline,
 * one line of subcopy and the two buttons — no heavy photo pushing CTAs below
 * the fold. A lightweight Florence-skyline SVG sits behind the content (near-zero
 * weight, no copyrighted imagery). Swap in an optimised WebP photo later if
 * desired — see docs/CONTENT-EDITING.md.
 */
import CtaButtons from './CtaButtons.astro';
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';
import { contact, telHref } from '../config/site';
import type { Lang } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <div class="hero__skyline" aria-hidden="true">
    <svg
      viewBox="0 0 1200 220"
      preserveAspectRatio="xMidYEnd slice"
      xmlns="http://www.w3.org/2000/svg"
    >
      <g fill="#1b3a6b" opacity="0.07">
        <rect x="60" y="150" width="70" height="70"></rect>
        <rect x="150" y="120" width="46" height="100"></rect>
        <path d="M210 220V120l30-22 30 22v100z"></path>
        <rect x="300" y="140" width="80" height="80"></rect>
        <!-- Duomo dome -->
        <path d="M470 220v-70a70 70 0 0 1 140 0v70z"></path>
        <rect x="524" y="70" width="32" height="30"></rect>
        <path d="M540 40l16 30h-32z"></path>
        <!-- campanile -->
        <rect x="640" y="90" width="34" height="130"></rect>
        <rect x="720" y="150" width="90" height="70"></rect>
        <path d="M840 220V130l34-24 34 24v90z"></path>
        <rect x="940" y="120" width="60" height="100"></rect>
        <rect x="1030" y="150" width="90" height="70"></rect>
      </g>
    </svg>
  </div>

  <div class="container hero__inner">
    <p class="eyebrow">{t.hero.kicker}</p>
    <h1 class="hero__title">{t.hero.title}</h1>
    <p class="hero__lead">{t.hero.subtitle}</p>

    <CtaButtons lang={lang} size="lg" showCallNumber={false} showServices={true} />

    <a class="hero__phone" href={telHref} data-tel>
      <Icon name="phone" size={18} />
      <span>{contact.phoneDisplay}</span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(1100px 480px at 85% -10%, var(--navy-50), transparent 60%),
      linear-gradient(180deg, #fff 0%, var(--bg-soft) 100%);
    overflow: hidden;
  }
  .hero__skyline {
    position: absolute;
    inset: auto 0 0 0;
    height: 220px;
    z-index: 0;
    pointer-events: none;
  }
  .hero__skyline svg {
    width: 100%;
    height: 100%;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
    padding-block: clamp(2.25rem, 7vw, 4.5rem);
    max-width: 44rem;
  }
  .hero__title {
    font-size: clamp(2rem, 7.2vw, 3.4rem);
    margin-bottom: 0.6rem;
  }
  .hero__lead {
    font-size: clamp(1.05rem, 2.6vw, 1.3rem);
    color: var(--muted);
    max-width: 34rem;
    margin-bottom: 1.5rem;
  }
  .hero__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 1.1rem;
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--navy);
    text-decoration: none;
  }
  .hero__phone:hover {
    color: var(--red);
  }
</style>
