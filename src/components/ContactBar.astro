---
/**
 * Persistent mobile Call | WhatsApp bar (hidden on desktop, where the header CTA
 * and repeated section CTAs do the job). Present from pixel zero — no scroll
 * trigger. Also hosts the one site-wide script that:
 *   - captures ?ref= / UTM attribution (first-touch, 90 days)
 *   - upgrades every [data-wa] link with the referral-tagged message
 *   - fires GA4 conversion events on WhatsApp / phone / email clicks
 */
import Icon from './Icon.astro';
import { useTranslations } from '../i18n';
import { telHref } from '../config/site';
import type { Lang } from '../config/site';
import { whatsappUrl, whatsappMessage } from '../lib/whatsapp';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const wa = whatsappUrl(lang);
---

<div
  class="contact-bar"
  role="region"
  aria-label={t.contactBar.call + ' / ' + t.contactBar.whatsapp}
>
  <a class="contact-bar__btn contact-bar__btn--call" href={telHref} data-tel>
    <Icon name="phone" size={22} />
    <span>{t.contactBar.call}</span>
  </a>
  <a
    class="contact-bar__btn contact-bar__btn--wa"
    href={wa}
    data-wa
    data-wa-msg={whatsappMessage(lang)}
    rel="noopener"
  >
    <Icon name="whatsapp" size={24} />
    <span>{t.contactBar.whatsapp}</span>
  </a>
</div>

<script>
  import { captureAttribution } from '../lib/attribution';
  import { trackEvent } from '../lib/analytics';

  const lang = document.documentElement.lang === 'it' ? 'it' : 'en';
  const page = () => location.pathname;
  const attr = captureAttribution();
  const ref = attr?.ref;

  // Fire a referral-visit event only when a ref actually arrived on this URL.
  if (ref && new URLSearchParams(location.search).get('ref')) {
    trackEvent('partner_referral_visit', { page: page(), language: lang }, attr);
  }

  const number = document.body.dataset.waNumber || '';
  const defaultMsg = document.body.dataset.waMsg || '';

  // Upgrade WhatsApp links: append the referral code to the prefilled message.
  document.querySelectorAll<HTMLAnchorElement>('[data-wa]').forEach((a) => {
    const base = a.dataset.waMsg || defaultMsg;
    let msg = base;
    if (ref) msg += '\nReferral: ' + ref;
    if (number) a.href = 'https://wa.me/' + number + '?text=' + encodeURIComponent(msg);
    a.addEventListener('click', () =>
      trackEvent('click_whatsapp', { page: page(), language: lang }, attr)
    );
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-tel]').forEach((a) => {
    a.addEventListener('click', () =>
      trackEvent('click_phone', { page: page(), language: lang }, attr)
    );
  });
  document.querySelectorAll<HTMLAnchorElement>('[data-email]').forEach((a) => {
    a.addEventListener('click', () =>
      trackEvent('click_email', { page: page(), language: lang }, attr)
    );
  });

  // Lightweight CTA intent events (services / tourist-help buttons opt in).
  document.querySelectorAll<HTMLElement>('[data-cta]').forEach((el) => {
    const name = el.dataset.cta;
    if (name === 'services' || name === 'tourist_help') {
      el.addEventListener('click', () =>
        trackEvent(
          name === 'services' ? 'cta_services' : 'cta_tourist_help',
          {
            page: page(),
            language: lang,
          },
          attr
        )
      );
    }
  });
</script>

<style>
  .contact-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 1px;
    background: var(--line);
    box-shadow: 0 -6px 20px rgba(15, 35, 64, 0.12);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .contact-bar__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 56px;
    font-weight: 700;
    font-size: 1.05rem;
    text-decoration: none;
    color: #fff;
  }
  .contact-bar__btn--call {
    background: var(--navy);
  }
  .contact-bar__btn--wa {
    background: var(--wa);
    color: #06331a;
  }
  .contact-bar__btn:active {
    filter: brightness(0.95);
  }
  @media (min-width: 900px) {
    .contact-bar {
      display: none;
    }
  }
</style>
