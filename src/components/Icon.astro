---
/**
 * Inline SVG icon set. Line icons (stroke) except brand glyphs (whatsapp).
 * Usage: <Icon name="phone" /> — inherits currentColor.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  title?: string;
}
const { name, size = 24, class: className, title } = Astro.props;
const stroke = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '2',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
} as const;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  class={className}
  role={title ? 'img' : undefined}
  aria-hidden={title ? undefined : 'true'}
  aria-label={title}
>
  {title && <title>{title}</title>}
  {
    name === 'phone' && (
      <path
        {...stroke}
        d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"
      />
    )
  }
  {
    name === 'whatsapp' && (
      <path
        fill="currentColor"
        d="M17.5 14.4c-.3-.2-1.7-.9-2-1-.3-.1-.5-.1-.6.1-.2.3-.7 1-.9 1.1-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.5-.5c.1-.2.2-.3.3-.5 0-.2 0-.4 0-.5 0-.2-.6-1.5-.9-2-.2-.5-.4-.5-.6-.5h-.5c-.2 0-.5.1-.7.3-.3.3-1 1-1 2.4 0 1.4 1 2.8 1.2 3 .1.2 2 3.1 5 4.3.7.3 1.2.5 1.6.6.7.2 1.3.2 1.8.1.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.2-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2z"
      />
    )
  }
  {
    name === 'email' && (
      <g {...stroke}>
        <rect x="2" y="4" width="20" height="16" rx="2" />
        <path d="m2 7 10 6 10-6" />
      </g>
    )
  }
  {
    name === 'nursing' && (
      <g {...stroke}>
        <path d="M12 2 4 5v6c0 5 3.4 8.3 8 10 4.6-1.7 8-5 8-10V5l-8-3Z" />
        <path d="M12 8v6M9 11h6" />
      </g>
    )
  }
  {
    name === 'physio' && (
      <g {...stroke}>
        <circle cx="12" cy="4.5" r="2" />
        <path d="M6 21c1.5-3 3-5 6-5s4.5 2 6 5M8 9l4-1 4 1M12 8v6" />
      </g>
    )
  }
  {
    name === 'tourist' && (
      <g {...stroke}>
        <rect x="3" y="7" width="18" height="13" rx="2" />
        <path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M12 11v5M9.5 13.5h5" />
      </g>
    )
  }
  {
    name === 'contact' && (
      <g {...stroke}>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </g>
    )
  }
  {
    name === 'home' && (
      <g {...stroke}>
        <path d="M3 11 12 4l9 7" />
        <path d="M5 10v9a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-9" />
        <path d="M10 20v-5h4v5" />
      </g>
    )
  }
  {
    name === 'language' && (
      <g {...stroke}>
        <circle cx="12" cy="12" r="9" />
        <path d="M3 12h18M12 3c2.5 2.5 3.8 5.6 3.8 9S14.5 18.5 12 21C9.5 18.5 8.2 15.4 8.2 12S9.5 5.5 12 3Z" />
      </g>
    )
  }
  {
    name === 'shield' && (
      <g {...stroke}>
        <path d="M12 2 5 5v6c0 4.4 3 7.6 7 9 4-1.4 7-4.6 7-9V5l-7-3Z" />
        <path d="m9 12 2 2 4-4" />
      </g>
    )
  }
  {name === 'arrow' && <path {...stroke} d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'check' && <path {...stroke} d="M20 6 9 17l-5-5" />}
  {name === 'chevron' && <path {...stroke} d="m6 9 6 6 6-6" />}
  {
    name === 'pin' && (
      <g {...stroke}>
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </g>
    )
  }
</svg>
