---
/**
 * Root entry. Static-host friendly language redirect: honours a saved language
 * preference, otherwise the browser language, defaulting to English (the
 * primary market). A <meta refresh> and a visible link keep it working with
 * JavaScript disabled. Canonical points to /en/.
 */
import { SITE_URL } from '../config/site';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Florence Care 24 — Healthcare Assistance & Coordination in Florence</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
    <link rel="alternate" hreflang="en" href={`${SITE_URL}/en/`} />
    <link rel="alternate" hreflang="it" href={`${SITE_URL}/it/`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}/en/`} />
    <meta http-equiv="refresh" content="0; url=/en/" />
    <script is:inline>
      (function () {
        // Preserve any ?ref= / utm_* / gclid query so first-touch attribution
        // survives the language redirect from the bare root URL.
        var qs = location.search || '';
        try {
          var saved = localStorage.getItem('fc24_lang');
          var lang =
            saved === 'it' || saved === 'en'
              ? saved
              : (navigator.language || 'en').toLowerCase().indexOf('it') === 0
                ? 'it'
                : 'en';
          location.replace('/' + lang + '/' + qs);
        } catch (e) {
          location.replace('/en/' + qs);
        }
      })();
    </script>
  </head>
  <body>
    <p style="font-family: sans-serif; padding: 2rem">
      Redirecting to <a href="/en/">Florence Care 24</a> —
      <a href="/it/">Italiano</a> · <a href="/en/">English</a>
    </p>
  </body>
</html>
