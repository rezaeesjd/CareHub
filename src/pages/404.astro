---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import { contact, telHref } from '../config/site';
import { whatsappUrl, whatsappMessage } from '../lib/whatsapp';
import { useTranslations } from '../i18n';

// 404 is language-neutral: primary copy in English with an Italian line.
const en = useTranslations('en').notFound;
const it = useTranslations('it').notFound;
const wa = whatsappUrl('en');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{en.metaTitle}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body data-wa-number={contact.whatsappNumber} data-wa-msg={whatsappMessage('en')}>
    <main class="nf">
      <div class="nf__card">
        <Logo lang="en" />
        <p class="nf__code">{en.code}</p>
        <h1>{en.title}</h1>
        <p class="nf__text">{en.text}</p>
        <p class="nf__text nf__text--it" lang="it">{it.text}</p>
        <div class="btn-row nf__actions">
          <a class="btn btn--call" href="/en/"><Icon name="home" size={18} /> {en.home}</a>
          <a
            class="btn btn--wa"
            href={wa}
            data-wa
            data-wa-msg={whatsappMessage('en')}
            rel="noopener"
          >
            <Icon name="whatsapp" size={20} /> WhatsApp
          </a>
        </div>
        <p class="nf__phone">
          <a href={telHref} data-tel><Icon name="phone" size={16} /> {contact.phoneDisplay}</a>
        </p>
      </div>
    </main>

    <script>
      import { initContactLinks } from '../lib/contact-links';
      initContactLinks();
    </script>

    <style>
      .nf {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 2rem 1rem;
        background: linear-gradient(180deg, #fff, var(--bg-soft));
      }
      .nf__card {
        text-align: center;
        max-width: 30rem;
      }
      .nf__code {
        font-size: 3rem;
        font-weight: 900;
        color: var(--red);
        margin: 1.25rem 0 0;
        line-height: 1;
      }
      .nf__text {
        color: var(--muted);
      }
      .nf__text--it {
        font-size: 0.95rem;
      }
      .nf__actions {
        justify-content: center;
        margin: 1.5rem 0 1rem;
      }
      .nf__phone a {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-weight: 700;
        color: var(--navy);
        text-decoration: none;
      }
      .nf__card :global(.logo) {
        justify-content: center;
      }
    </style>
  </body>
</html>
