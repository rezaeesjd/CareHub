---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ContactButtons from '../../components/ContactButtons.astro'; import {languages,t,paths,type Lang} from '../../i18n/content'; import {providerModel} from '../../config/site';
export function getStaticPaths(){return languages.map(lang=>({params:{lang}}))}
const lang=Astro.params.lang as Lang,x=t[lang],p=paths[lang],other=lang==='en'?paths.it.home:paths.en.home;
const c=lang==='en'?{title:'Medical help in Florence when you need it most.',desc:'Healthcare assistance and coordination at home, hotels and accommodation in Florence.',support:'We help connect you with qualified healthcare professionals for assistance at your home, hotel or accommodation in Florence.',trust:['English & Italian support','Home and hotel visits','Qualified healthcare professionals','Weekend and holiday availability','Coordination according to your needs'],serviceTitle:'Healthcare support, made simpler',serviceIntro:'Start with one point of contact. We help understand your request and coordinate the appropriate next step.',nursing:'Nursing Care',nursingNote:'At home, in hotels and accommodation facilities.',physio:'Physiotherapy',physioNote:'Home visits with professional equipment.',visitor:'Tourists & International Visitors',visitorNote:'English-language help navigating healthcare while you are in Florence.',viewN:'View Nursing Services',viewP:'View Physiotherapy Services',viewT:'Healthcare Help for Visitors',howTitle:'Four simple steps',steps:[['Contact Us','Call or WhatsApp and explain what you need.'],['We Understand Your Request','We gather the information needed to understand the request and next step.'],['We Connect You','This may involve a nurse, doctor, physiotherapist, laboratory, pharmacy or another qualified professional.'],['Care & Follow-Up','The professional provides the service and we assist with coordination where applicable.']],additional:'Additional Healthcare Coordination',additionalText:'We can coordinate doctor consultations, home visits, telemedicine, laboratories, pharmacies, specialists, diagnostics and post-operative pathways.'}:{title:'Aiuto sanitario a Firenze quando ne hai più bisogno.',desc:'Assistenza sanitaria e coordinamento a domicilio, in hotel e negli alloggi a Firenze.',support:'Ti aiutiamo a entrare in contatto con professionisti sanitari qualificati per assistenza a casa, in hotel o nel tuo alloggio a Firenze.',trust:['Supporto in italiano e inglese','Visite a casa e in hotel','Professionisti sanitari qualificati','Disponibilità nei weekend e festivi','Coordinamento secondo le tue necessità'],serviceTitle:'Supporto sanitario più semplice',serviceIntro:'Inizia da un unico contatto. Comprendiamo la richiesta e coordiniamo il passo successivo più appropriato.',nursing:'Assistenza infermieristica',nursingNote:'A domicilio, in hotel e nelle strutture ricettive.',physio:'Fisioterapia',physioNote:'Visite a domicilio con attrezzatura professionale.',visitor:'Turisti e visitatori internazionali',visitorNote:'Supporto in inglese per orientarsi nel sistema sanitario durante il soggiorno.',viewN:'Servizi infermieristici',viewP:'Fisioterapia a domicilio',viewT:'Assistenza per visitatori',howTitle:'Quattro semplici passaggi',steps:[['Contattaci','Chiama o scrivi su WhatsApp e spiega la necessità.'],['Comprendiamo la richiesta','Raccogliamo le informazioni necessarie per individuare il passo successivo.'],['Ti mettiamo in contatto','Può essere coinvolto un infermiere, medico, fisioterapista, laboratorio, farmacia o altro professionista.'],['Assistenza e follow-up','Il professionista svolge la prestazione e noi aiutiamo nel coordinamento, dove applicabile.']],additional:'Coordinamento di altri servizi sanitari',additionalText:'Possiamo coordinare consulti e visite mediche, telemedicina, laboratori, farmacie, specialisti, diagnostica e percorsi post-operatori.'};
---
<BaseLayout {lang} title={c.title} description={c.desc} alternate={other}>
<section class="hero"><div class="shell hero-grid"><div><p class="eyebrow">Healthcare Assistance & Coordination</p><h1>{c.title}</h1><p class="lead">{c.support}</p><ContactButtons {lang}/><ul class="trust">{c.trust.map(i=><li>{i}</li>)}</ul></div><div class="hero-art" role="img" aria-label={lang==='en'?'Florence healthcare coordination illustration':'Illustrazione del coordinamento sanitario a Firenze'}><div class="skyline">Florence · Firenze</div></div></div></section>
<div class="shell"><section class="unsure"><div><h2>{x.notSure}</h2><p>{x.notSureText}</p></div><ContactButtons {lang} compact/></section></div>
<section class="section" id="services"><div class="shell"><div class="center"><p class="eyebrow">{x.services}</p><h2>{c.serviceTitle}</h2><p>{c.serviceIntro}</p></div><div class="cards"><article class="card"><span class="icon">✚</span><h3>{c.nursing}</h3><p>{c.nursingNote}</p><ul><li>{lang==='en'?'Wound care and dressings':'Medicazioni e ferite'}</li><li>{lang==='en'?'Injections and blood sampling':'Iniezioni e prelievi'}</li><li>{lang==='en'?'Post-operative assistance':'Assistenza post-operatoria'}</li><li>{lang==='en'?'IV therapies — prescription when required':'Terapie EV — prescrizione quando necessaria'}</li></ul><a class="text-link" data-event="cta_services" href={lang==='en'?'/en/nurse-at-home-florence/':'/it/infermiere-a-domicilio-firenze/'}>{c.viewN} →</a></article><article class="card"><span class="icon">◌</span><h3>{c.physio}</h3><p>{c.physioNote}</p><ul><li>{lang==='en'?'Mobility assistance':'Assistenza alla mobilità'}</li><li>{lang==='en'?'Post-operative rehabilitation':'Riabilitazione post-operatoria'}</li><li>{lang==='en'?'Manual therapy':'Terapia manuale'}</li><li>{lang==='en'?'Functional recovery':'Recupero funzionale'}</li></ul><a class="text-link" href={lang==='en'?'/en/home-physiotherapy-florence/':'/it/fisioterapia-a-domicilio-firenze/'}>{c.viewP} →</a></article><article class="card"><span class="icon">◎</span><h3>{c.visitor}</h3><p>{c.visitorNote}</p><ul><li>{lang==='en'?'Hotel healthcare assistance':'Assistenza sanitaria in hotel'}</li><li>{lang==='en'?'Doctor and pharmacy coordination':'Coordinamento medico e farmacia'}</li><li>{lang==='en'?'Insurance document support':'Supporto documenti assicurativi'}</li></ul><a class="text-link" data-event="cta_tourist_help" href={p.tourist}>{c.viewT} →</a></article></div></div></section>
<section class="section tint" id="how"><div class="shell"><p class="eyebrow">{x.how}</p><h2>{c.howTitle}</h2><div class="steps">{c.steps.map(s=><article class="step"><h3>{s[0]}</h3><p>{s[1]}</p></article>)}</div></div></section>
<section class="section"><div class="shell content-grid"><div><p class="eyebrow">Florence Care coordination</p><h2>{c.additional}</h2><p class="lead">{c.additionalText}</p><p>{providerModel[lang]}</p></div><div class="side-card"><h2>{x.notSure}</h2><p>{x.notSureText}</p><ContactButtons {lang} compact/></div></div></section>
</BaseLayout>
