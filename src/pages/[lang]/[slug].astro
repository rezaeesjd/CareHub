---
import BaseLayout from '../../layouts/BaseLayout.astro'; import ContactButtons from '../../components/ContactButtons.astro'; import {pages} from '../../content/pages'; import {paths,t,type Lang} from '../../i18n/content'; import {providerModel} from '../../config/site';
export function getStaticPaths(){return pages.map(page=>({params:{lang:page.lang,slug:page.slug},props:{page}}))} const {page}=Astro.props; const lang=page.lang as Lang; const alternate=`/${lang==='en'?'it':'en'}/${page.alt}/`; const breadcrumb={'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:t[lang].home,item:paths[lang].home},{'@type':'ListItem',position:2,name:page.title}]};const faq=page.faq?{'@context':'https://schema.org','@type':'FAQPage',mainEntity:page.faq.map((f:any)=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}:undefined;
---
<BaseLayout {lang} title={page.title} description={page.description} {alternate} schema={[breadcrumb,...(faq?[faq]:[])]}><section class="page-hero"><div class="shell"><p class="eyebrow">Healthcare Assistance & Coordination</p><h1>{page.title}</h1><p class="lead">{page.intro}</p><ContactButtons {lang}/></div></section><section class="section"><div class="shell content-grid"><article class="prose">{page.sections.map((s:any)=><section><h2>{s.title}</h2><p>{s.body}</p>{s.items&&<ul>{s.items.map((i:string)=><li>{i}</li>)}</ul>}</section>)}{page.faq&&<section class="faq"><h2>FAQ</h2>{page.faq.map((f:any)=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>}<p>{providerModel[lang]}</p></article><aside class="side-card"><h2>{t[lang].notSure}</h2><p>{t[lang].notSureText}</p><ContactButtons {lang} compact/></aside></div></section></BaseLayout>
