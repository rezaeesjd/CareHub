---
import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import ContactButtons from '../components/ContactButtons.astro'; import {site} from '../config/site'; import {paths,type Lang} from '../i18n/content'; import {canonical} from '../lib/links'; import '../styles/global.css';
interface Props{lang:Lang;title:string;description:string;alternate:string;schema?:Record<string,unknown>|Record<string,unknown>[]} const {lang,title,description,alternate,schema}=Astro.props; const current=Astro.url.pathname; const url=canonical(current); const altLang=lang==='en'?'it':'en';
const defaultSchema={'@context':'https://schema.org','@type':'Organization',name:site.name,url:site.url||undefined,telephone:site.phone,email:site.email,areaServed:{'@type':'City',name:'Florence'},availableLanguage:['English','Italian'],sameAs:site.socials};
---
<!doctype html><html lang={lang}><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#075985"><title>{title} | Florence Care 24</title><link rel="canonical" href={url}><link rel="alternate" hreflang={lang} href={url}><link rel="alternate" hreflang={altLang} href={canonical(alternate)}><link rel="alternate" hreflang="x-default" href={canonical(paths.en.home)}><meta property="og:type" content="website"><meta property="og:title" content={`${title} | Florence Care 24`}><meta property="og:description" content={description}><meta property="og:url" content={url}><meta property="og:site_name" content="Florence Care 24"><meta name="twitter:card" content="summary"><meta name="twitter:title" content={`${title} | Florence Care 24`}><meta name="twitter:description" content={description}><link rel="icon" href="/favicon.svg"><script type="application/ld+json" set:html={JSON.stringify([defaultSchema,...(Array.isArray(schema)?schema:schema?[schema]:[])])} /></head><body data-lang={lang}>
<Header {lang} {alternate}/><main id="main"><slot/></main><Footer {lang}/><aside class="mobile-bar" aria-label="Contact"><ContactButtons {lang} compact /></aside>
<script is:inline define:vars={{gaId:site.gaId,gtmId:site.gtmId}}>
(()=>{const key='fc24_attribution',params=new URLSearchParams(location.search),clean=v=>v&&v.replace(/[^a-zA-Z0-9_.-]/g,'').slice(0,150);localStorage.setItem('fc24_language',document.body.dataset.lang);if(!localStorage.getItem(key)){const a={ref:clean(params.get('ref')),landingPage:location.pathname,timestamp:new Date().toISOString(),utmSource:clean(params.get('utm_source')),utmMedium:clean(params.get('utm_medium')),utmCampaign:clean(params.get('utm_campaign')),utmContent:clean(params.get('utm_content')),gclid:clean(params.get('gclid'))};if(Object.values(a).some(Boolean))localStorage.setItem(key,JSON.stringify(a));}let attribution={};try{attribution=JSON.parse(localStorage.getItem(key)||'{}')}catch{};window.dataLayer=window.dataLayer||[];const track=(event,extra={})=>window.dataLayer.push({event,page:location.pathname,language:document.body.dataset.lang,referral_code:attribution.ref,utm_campaign:attribution.utmCampaign,...extra});document.querySelectorAll('[data-channel]').forEach(el=>el.addEventListener('click',()=>{const channel=el.dataset.channel;if(channel==='whatsapp'){const base=el.dataset.baseHref||el.href;if(attribution.ref){const u=new URL(base);u.searchParams.set('text',decodeURIComponent(u.searchParams.get('text')||'')+'\nReferral: '+attribution.ref);el.href=u.toString();}}track('click_'+channel);}));document.querySelectorAll('[data-event]').forEach(el=>el.addEventListener('click',()=>track(el.dataset.event)));const b=document.querySelector('.menu-button'),n=document.querySelector('#nav');b?.addEventListener('click',()=>{const open=b.getAttribute('aria-expanded')==='true';b.setAttribute('aria-expanded',String(!open));n?.classList.toggle('open',!open)});if(attribution.ref)track('partner_referral_visit');if((gaId||gtmId)&&localStorage.getItem('fc24_analytics_consent')==='granted'){const id=gtmId||gaId,s=document.createElement('script');s.async=true;s.src=gtmId?'https://www.googletagmanager.com/gtm.js?id='+id:'https://www.googletagmanager.com/gtag/js?id='+id;document.head.appendChild(s);if(gaId){window.gtag=function(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config',gaId,{anonymize_ip:true});}}})();
</script></body></html>
