{
  "name": "florence-care-24",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Florence Care 24 — Healthcare Assistance & Coordination. Conversion-first bilingual (EN/IT) static website.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "prettier --check \"**/*.{astro,ts,js,mjs,md,css,json}\"",
    "format": "prettier --write \"**/*.{astro,ts,js,mjs,md,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:dist": "node scripts/verify-dist.mjs",
    "partner:create": "node scripts/partner-qr.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "astro": "^5.6.1",
    "@astrojs/sitemap": "^3.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "prettier": "^3.5.3",
    "prettier-plugin-astro": "^0.14.1",
    "qrcode": "^1.5.4",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
